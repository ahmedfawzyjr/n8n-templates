{
  "name": "AI-Powered Multi-Engine OCR and Document Processing Pipeline",
  "nodes": [
    {
      "id": "e1f10001-0001-4000-8000-000000000001",
      "name": "Document Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        200
      ],
      "webhookId": "ocr-doc-upload-pipeline",
      "parameters": {
        "httpMethod": "POST",
        "path": "ocr-document-pipeline",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false
        }
      }
    },
    {
      "id": "e1f10001-0001-4000-8000-000000000002",
      "name": "Preprocess & Validate Binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        200
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const binaryData = item.binary ? Object.keys(item.binary)[0] : null;\n  const docType = item.json.body?.document_type || item.json.query?.document_type || 'invoice';\n  const metadata = item.json.body?.metadata || {};\n  \n  output.push({\n    json: {\n      hasBinary: !!binaryData,\n      binaryKey: binaryData || 'data',\n      documentType: docType,\n      documentId: metadata.document_id || 'DOC-' + Date.now(),\n      receivedAt: new Date().toISOString(),\n      prompt: `Analyze this ${docType} image/document thoroughly using OCR. Extract the following fields with high precision:\n- document_number (string)\n- issue_date (YYYY-MM-DD)\n- due_date (YYYY-MM-DD or null)\n- vendor_name (string)\n- vendor_tax_id (string or null)\n- customer_name (string)\n- currency (e.g. USD, EUR, GBP)\n- subtotal (number)\n- tax_amount (number)\n- total_amount (number)\n- line_items: array of objects { description, quantity, unit_price, total_price }\n- confidence_score: estimated extraction confidence between 0 and 100 based on image readability and completeness\n- notes: any discrepancies or special clauses detected`\n    },\n    binary: item.binary || {}\n  });\n}\n\nreturn output;"
      }
    },
    {
      "id": "e1f10001-0001-4000-8000-000000000003",
      "name": "Multimodal Vision OCR LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        -140,
        200
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "messages": {
          "messageValues": [
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary",
              "binaryImageDataKey": "={{ $json.binaryKey }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "e1f10001-0001-4000-8000-000000000004",
      "name": "OpenAI GPT-4o Vision Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        -200,
        420
      ],
      "parameters": {
        "model": "gpt-4o",
        "options": {
          "temperature": 0.1,
          "maxTokens": 2048
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openAiApiCredential",
          "name": "OpenAI Account"
        }
      }
    },
    {
      "id": "e1f10001-0001-4000-8000-000000000005",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        -60,
        420
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"document_number\": { \"type\": \"string\" },\n    \"issue_date\": { \"type\": \"string\" },\n    \"due_date\": { \"type\": [\"string\", \"null\"] },\n    \"vendor_name\": { \"type\": \"string\" },\n    \"vendor_tax_id\": { \"type\": [\"string\", \"null\"] },\n    \"customer_name\": { \"type\": \"string\" },\n    \"currency\": { \"type\": \"string\" },\n    \"subtotal\": { \"type\": \"number\" },\n    \"tax_amount\": { \"type\": \"number\" },\n    \"total_amount\": { \"type\": \"number\" },\n    \"confidence_score\": { \"type\": \"number\" },\n    \"line_items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"description\": { \"type\": \"string\" },\n          \"quantity\": { \"type\": \"number\" },\n          \"unit_price\": { \"type\": \"number\" },\n          \"total_price\": { \"type\": \"number\" }\n        },\n        \"required\": [\"description\", \"quantity\", \"unit_price\", \"total_price\"]\n      }\n    },\n    \"notes\": { \"type\": \"string\" }\n  },\n  \"required\": [\"document_number\", \"vendor_name\", \"customer_name\", \"total_amount\", \"confidence_score\"]\n}"
      }
    },
    {
      "id": "e1f10001-0001-4000-8000-000000000006",
      "name": "Parse & Validate OCR Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        200
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nlet extracted = item.json.output || item.json.text || item.json;\n\nif (typeof extracted === 'string') {\n  try {\n    extracted = JSON.parse(extracted);\n  } catch (e) {\n    // regex fallback\n    const jsonMatch = extracted.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) extracted = JSON.parse(jsonMatch[0]);\n  }\n}\n\nconst confidence = extracted.confidence_score || 75;\nconst isValid = confidence >= 85 && !!extracted.document_number && !!extracted.total_amount;\n\nreturn [{\n  json: {\n    ...extracted,\n    document_id: $('Preprocess & Validate Binary').first().json.documentId,\n    processed_at: new Date().toISOString(),\n    status: isValid ? 'CONFIRMED' : 'NEEDS_REVIEW',\n    confidence_score: confidence,\n    requires_human_review: !isValid\n  }\n}];"
      }
    },
    {
      "id": "e1f10001-0001-4000-8000-000000000007",
      "name": "Check Confidence Threshold",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        360,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "confidence-check",
              "leftValue": "={{ $json.confidence_score }}",
              "rightValue": 85,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "e1f10001-0001-4000-8000-000000000008",
      "name": "PostgreSQL Save Document Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        620,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ocr_processed_documents (document_id, document_number, vendor_name, customer_name, total_amount, currency, confidence_score, status, raw_data, created_at)\nVALUES (\n  '{{ $json.document_id }}',\n  '{{ $json.document_number }}',\n  '{{ $json.vendor_name }}',\n  '{{ $json.customer_name }}',\n  {{ $json.total_amount }},\n  '{{ $json.currency }}',\n  {{ $json.confidence_score }},\n  '{{ $json.status }}',\n  '{{ JSON.stringify($json) }}',\n  NOW()\n)\nON CONFLICT (document_id) DO UPDATE SET\n  status = EXCLUDED.status,\n  total_amount = EXCLUDED.total_amount,\n  updated_at = NOW();"
      },
      "credentials": {
        "postgres": {
          "id": "postgresCredentials",
          "name": "Postgres Production Database"
        }
      }
    },
    {
      "id": "e1f10001-0001-4000-8000-000000000009",
      "name": "Google Sheets Append Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        840,
        100
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1xY_OCR_Document_Audit_Log_SpreadsheetId",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Processed_Invoices",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Document ID": "={{ $json.document_id }}",
            "Doc Number": "={{ $json.document_number }}",
            "Vendor": "={{ $json.vendor_name }}",
            "Total": "={{ $json.total_amount }}",
            "Currency": "={{ $json.currency }}",
            "Confidence": "={{ $json.confidence_score }}%",
            "Processed At": "={{ $json.processed_at }}"
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googleSheetsCredentials",
          "name": "Google Sheets Production Account"
        }
      }
    },
    {
      "id": "e1f10001-0001-4000-8000-000000000010",
      "name": "Slack Alert for Human Review",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        620,
        340
      ],
      "parameters": {
        "operation": "post",
        "channel": "#finance-ocr-alerts",
        "text": "=⚠️ *OCR Extraction Flagged for Manual Review*\n• *Document ID:* `{{ $json.document_id }}`\n• *Vendor:* {{ $json.vendor_name || 'Unknown' }}\n• *Extracted Total:* {{ $json.currency || '$' }}{{ $json.total_amount || 0 }}\n• *Confidence Score:* `{{ $json.confidence_score }}%` (Below 85% Threshold)\n• *Notes:* {{ $json.notes || 'Fields missing or low readability.' }}\n\n👉 <https://app.company.internal/ocr/review/{{ $json.document_id }}|Review & Approve Document>",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "slackCredentials",
          "name": "Finance Ops Slack"
        }
      }
    },
    {
      "id": "e1f10001-0001-4000-8000-000000000011",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1080,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"status\": \"{{ $json.status }}\",\n  \"document_id\": \"{{ $json.document_id }}\",\n  \"confidence_score\": {{ $json.confidence_score }},\n  \"data\": {\n    \"document_number\": \"{{ $json.document_number }}\",\n    \"vendor_name\": \"{{ $json.vendor_name }}\",\n    \"customer_name\": \"{{ $json.customer_name }}\",\n    \"total_amount\": {{ $json.total_amount }},\n    \"currency\": \"{{ $json.currency }}\"\n  },\n  \"requires_human_review\": {{ $json.requires_human_review }}\n}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
